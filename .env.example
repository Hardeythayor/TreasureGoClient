# Satellite imagery source for the map. Defaults to Esri World Imagery —
# free, no key needed. Set VITE_SATELLITE_PMTILES_URL to a self-hosted
# .pmtiles raster archive instead (works fully offline once cached; takes
# priority over everything else). Or set VITE_SATELLITE_PROVIDER=maptiler
# plus VITE_MAPTILER_KEY to use MapTiler's hosted tiles instead of Esri.
VITE_SATELLITE_PMTILES_URL=
VITE_SATELLITE_PROVIDER=
VITE_MAPTILER_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
VITE_API_BASE_URL=
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=
VITE_PUSHER_BEAMS_INSTANCE_ID=
